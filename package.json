{
  "name": "gpx-builder",
  "version": "6.0.0",
  "description": "Builder of GPX files",
  "keywords": [
    "gpx",
    "garmin",
    "gpx-generator",
    "gps"
  ],
  "homepage": "https://github.com/fabulator/gpx-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabulator/gpx-builder.git"
  },
  "license": "Apache-2.0",
  "author": "Michal Ozogán <michal@ozogan.eu>",
  "main": "dist/index.js",
  "module": "es/index.js",
  "jsnext:main": "es/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup --config ./rollup.config.mjs",
    "lint": "eslint .",
    "lint:export": "npm run lint -- -o ./tests_results/checkstyle/js-checkstyle.xml -f checkstyle",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run tsc",
    "release": "semantic-release",
    "test": "vitest run",
    "test:all": "npm run lint && npm run typecheck && npm test",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^8.1.3",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@types/node": "^26.6.6",
    "babel-config-fabulator": "^2.0.0",
    "commitlint-config-fabulator": "^6.1.0",
    "eslint": "^10.15.0",
    "eslint-config-fabulator": "^6.0.1",
    "husky": "^9.1.7",
    "rollup-config-fabulator": "^3.0.0",
    "semantic-release-config-fabulator": "^8.0.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  },
  "bugs": {
    "url": "https://github.com/fabulator/gpx-builder/issues"
  }
}
